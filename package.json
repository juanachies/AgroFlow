{
  "name": "agroflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/interfaces/http/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "demo:flujo": "node src/interfaces/cli/demoFlujo.js",
    "actualizar-tarifas": "node src/infrastructure/tarifas/actualizarTarifas.js",
    "demo": "node src/interfaces/cli/demoPlan.js",
    "update:weather": "node src/interfaces/cli/refreshWeather.js",
    "dev": "vite",
    "build": "vite build",
    "dev:api": "node --env-file-if-exists=.env.local --watch src/interfaces/http/server.js",
    "demo:venta": "node src/interfaces/cli/demoVenta.js",
    "db:migrate:accounts": "node --env-file=.env.local scripts/migrateAccounts.js"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@vercel/functions": "^3.11.3",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.18.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
